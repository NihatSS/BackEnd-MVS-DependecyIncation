@model Work

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            <div class="project-info-box mt-0">
                <h5>WORK DETAILS</h5>
                <p class="mb-0"> @Model.Title</p>
                <p class="mb-0"> @Model.Description</p>
            </div><!-- / project-info-box -->


            
        </div><!-- / column -->

        <div class="col-md-7">
            <img src="~/assets/img/@Model.Image" alt="project-image" class="rounded">
            <div class="project-info-box">
                <p><b>Category:</b> @Model.Category.Name</p>
            </div><!-- / project-info-box -->
        </div><!-- / column -->
    </div>
</div>